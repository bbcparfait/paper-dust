    "textCodeBlock.background": "#EAE7DF"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#898680",
        "fontStyle": "italic"
      }
    },
    {
      "name": "HTML tags",
      "scope": ["entity.name.tag", "entity.name.tag.html"],
      "settings": {
        "foreground": "#98624E"
      }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#89517F",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings",
      "scope": ["string"],
      "settings": {
        "foreground": "#47734F"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.type.interface",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#287A80",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language"],
      "settings": {
        "foreground": "#B07836"
      }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#416D9A"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": {
      "foreground": "#287A80",
      "bold": true
    },
    "interface": {
      "foreground": "#287A80",
      "bold": true
    },
    "type": {
      "foreground": "#287A80",
      "bold": true
    },
    "function": "#416D9A",
    "method": "#416D9A",
    "parameter": "#343331",
    "parameter.declaration": "#343331",
    "variable.readonly": "#343331",
    "variable.defaultLibrary": "#343331",
    "variable": "#343331",
    "property": "#343331"
  }
}
